{
  "version": 1,
  "sdk_version": "3.3.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yrcxqyadtftveuzbjiup.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "baukosten-mcp",
      "version": "0.1.0",
      "title": "Baukosten Tracker"
    },
    "tools": [
      {
        "name": "list_invoices",
        "title": "List invoices",
        "description": "Lists invoices in the signed-in user's household, most recent first. Amounts are in EUR.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "only_unpaid": {
              "description": "If true, return only unpaid invoices.",
              "type": "boolean"
            },
            "kostengruppe_prefix": {
              "description": "Filter by DIN 276 cost-group code prefix, e.g. '3' or '310'.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_offers",
        "title": "List offers",
        "description": "Lists contractor offers in the signed-in user's household. Amounts are in EUR.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_estimate_versions",
        "title": "List estimate versions",
        "description": "Lists all cost-estimate versions (V1, V2, ...) in the household with their blocks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "budget_summary",
        "title": "Budget summary (target vs actual)",
        "description": "Returns target (from the active estimate version) vs actual (sum of invoices) per DIN 276 3-digit cost group. Amounts in EUR.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "version_id": {
              "description": "Estimate version to use as target. Defaults to the active version.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
